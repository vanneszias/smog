{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "concurrency": "3",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "build/**"]
    },
    "check-types": {
      "cache": false,
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#test:scripts": {
      "cache": false
    },
    "//#check-types:scripts": {
      "cache": false
    },
    "@smog/testing#check-types": {
      "cache": false,
      "dependsOn": [
        "^check-types",
        "@smog/site#check-types",
        "@smog/mobile#check-types"
      ]
    }
  }
}
