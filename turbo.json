{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        "dist/**",
        "build/**",
        ".next/**",
        "!.next/cache/**",
        ".open-next/**"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "generate:types:cloudflare"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate:types:cloudflare": {
      "cache": false,
      "outputs": ["cloudflare-env.d.ts"]
    },
    "generate:types": {
      "cache": false,
      "outputs": ["cloudflare-env.d.ts", "src/payload-types.ts"]
    },
    "generate:importmap": {
      "cache": false,
      "outputs": ["src/app/(payload)/admin/importMap.js"]
    },
    "ios": {
      "cache": false,
      "persistent": true
    },
    "android": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false
    },
    "convex:codegen": {
      "cache": false,
      "outputs": ["convex/_generated/**"]
    },
    "convex:dev": {
      "cache": false,
      "persistent": true
    },
    "convex:deploy": {
      "cache": false
    }
  }
}
