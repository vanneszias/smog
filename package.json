{
  "name": "smog",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "packages/features/*"
    ],
    "catalog": {
      "@types/bun": "1.4.2",
      "typescript": "7.0.2"
    }
  },
  "scripts": {
    "boundaries": "bun scripts/check-boundaries.ts",
    "build": "turbo build",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "check-types": "turbo check-types",
    "dev": "turbo dev",
    "knip": "knip --no-progress",
    "release:check": "bun run check:ci && bun run check-types && bun run test && bun run build && bun run knip",
    "test": "turbo test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "catalog:",
    "knip": "6.38.0",
    "turbo": "2.11.5",
    "typescript": "catalog:",
    "ultracite": "7.12.2"
  },
  "packageManager": "bun@1.3.11"
}
