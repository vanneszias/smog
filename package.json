{
  "name": "smog",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "4.3.6"
    }
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@radix-ui/react-dismissable-layer": "1.1.19",
    "@xmldom/xmldom": "0.8.15",
    "decode-uri-component": "0.5.0",
    "dompurify": "3.4.15",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.25.12",
    "expo-application": "55.0.19",
    "expo-constants": "55.0.17",
    "fast-uri": "4.2.1",
    "form-data": "4.0.6",
    "js-yaml": "3.15.2",
    "lodash": "4.18.1",
    "node-forge": "1.4.0",
    "picomatch": "4.0.4",
    "postcss": "8.5.28",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "rollup": "4.62.2",
    "sharp": "0.35.4",
    "shell-quote": "1.9.0",
    "undici": "7.29.1",
    "uuid": "11.1.1",
    "ws": "8.21.0",
    "yaml": "2.9.0"
  },
  "scripts": {
    "check": "biome check --write .",
    "check:ci": "biome check apps packages scripts package.json turbo.json biome.json knip.json",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "release:check": "bun run check:ci && bun run release:config-check && bun run check-types && bun run test && bun audit --production && bun run mobile:release-check && bun run build && knip --no-progress --no-config-hints",
    "release:check:ci": "bun run check:ci && bun run release:config-check && bun run check-types && turbo test --filter=!site && bun audit --production && bun run mobile:release-check && bun run build && knip --no-progress --no-config-hints",
    "release:config-check": "bun scripts/release-config-check.ts",
    "mobile:release-check": "bun scripts/mobile-release-check.ts",
    "dev:mobile": "turbo -F mobile dev",
    "dev:site": "turbo -F site dev",
    "mobile:ios": "turbo -F mobile ios --",
    "mobile:android": "turbo -F mobile android --"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@types/bun": "^1.4.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "expo-doctor": "1.20.0",
    "knip": "^5.88.1",
    "turbo": "^2.11.2",
    "ultracite": "7.1.1"
  },
  "patchedDependencies": {
    "@openpanel/react-native@1.4.1": "patches/@openpanel%2Freact-native@1.4.1.patch",
    "query-string@7.1.3": "patches/query-string@7.1.3.patch"
  }
}
