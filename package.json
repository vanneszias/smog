{
  "name": "smog",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "packages/features/*"
    ],
    "catalog": {
      "@axe-core/playwright": "4.14.0",
      "@cloudflare/vite-plugin": "1.64.0",
      "@cloudflare/vitest-plugin": "1.4.6",
      "@openpanel/react-native": "1.4.1",
      "@orpc/client": "1.15.7",
      "@orpc/contract": "1.15.7",
      "@orpc/openapi": "1.15.7",
      "@orpc/server": "1.15.7",
      "@orpc/tanstack-query": "1.15.7",
      "@orpc/zod": "1.15.7",
      "@playwright/test": "1.64.1",
      "@react-native-async-storage/async-storage": "2.2.0",
      "@tanstack/query-core": "5.104.5",
      "@tanstack/react-query": "5.104.5",
      "@testing-library/react-native": "14.1.0",
      "@types/bun": "1.4.3",
      "@types/react": "19.2.18",
      "aws4fetch": "1.0.20",
      "drizzle-orm": "0.45.4",
      "fflate": "0.8.3",
      "i18next": "26.5.3",
      "lucide-react": "1.60.0",
      "lucide-react-native": "1.60.0",
      "nativewind": "4.2.7",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "react-i18next": "17.1.0",
      "test-renderer": "1.3.1",
      "typescript": "7.0.2",
      "vite": "8.3.4",
      "vitest": "4.1.12",
      "wrangler": "4.151.3",
      "zod": "4.6.7"
    }
  },
  "scripts": {
    "admin:grant": "bun scripts/admin-grant.ts",
    "audit": "bun audit",
    "boundaries": "bun scripts/check-boundaries.ts",
    "build": "turbo build",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "check-types": "turbo run check-types check-types:scripts",
    "check-types:scripts": "tsc -p scripts",
    "cron": "bun scripts/cron.ts",
    "dev": "turbo dev",
    "knip": "knip --no-progress",
    "maintenance": "bun scripts/maintenance.ts",
    "migrate:convex": "bun -F @smog/migrate-convex cli",
    "mobile:release-check": "bun scripts/mobile-release-check.ts",
    "release:check": "bun run release:check:core && bun run release:check:tests && bun run release:check:mobile",
    "release:check:core": "bun run check:ci && bun run boundaries && bun scripts/release-config-check.ts && bun run check-types && bun run build && bun -F @smog/site deploy:dry && bun scripts/check-deploy-config.ts --env staging --offline && bun run knip && bun run audit",
    "release:check:mobile": "bun run mobile:release-check",
    "release:check:tests": "bun run test",
    "retention": "bun scripts/retention.ts",
    "test": "turbo run test test:scripts --log-order=stream",
    "test:e2e": "bun scripts/e2e.ts",
    "test:scripts": "bun scripts/test-deadline.ts -- bun test ./scripts"
  },
  "overrides": {
    "decode-uri-component": "0.5.1",
    "deepmerge": "file:vendor/deepmerge",
    "esbuild": "0.28.2",
    "fast-uri": "3.1.9",
    "happy-dom": "21.0.4",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@smog/config": "workspace:*",
    "@smog/jobs": "workspace:*",
    "@types/bun": "catalog:",
    "deepmerge": "file:vendor/deepmerge",
    "knip": "6.42.1",
    "turbo": "2.11.9",
    "typescript": "catalog:",
    "ultracite": "8.0.1"
  },
  "packageManager": "bun@1.3.11",
  "patchedDependencies": {
    "@openpanel/react-native@1.4.1": "patches/@openpanel%2Freact-native@1.4.1.patch",
    "query-string@7.1.3": "patches/query-string@7.1.3.patch"
  }
}
