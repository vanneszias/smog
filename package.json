{
  "name": "smog",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "packages/features/*"
    ],
    "catalog": {
      "@cloudflare/containers": "0.3.7",
      "@cloudflare/vite-plugin": "1.62.5",
      "@cloudflare/vitest-plugin": "1.3.6",
      "@fontsource/inter": "5.3.0",
      "@openpanel/react-native": "1.4.1",
      "@orpc/client": "1.15.4",
      "@orpc/contract": "1.15.4",
      "@orpc/openapi": "1.15.4",
      "@orpc/server": "1.15.4",
      "@orpc/tanstack-query": "1.15.4",
      "@orpc/zod": "1.15.4",
      "@react-native-async-storage/async-storage": "2.2.0",
      "@remotion/bundler": "4.0.532",
      "@remotion/fonts": "4.0.532",
      "@remotion/layout-utils": "4.0.532",
      "@remotion/player": "4.0.532",
      "@remotion/renderer": "4.0.532",
      "@tanstack/react-query": "5.104.0",
      "@testing-library/react-native": "14.0.1",
      "@types/bun": "1.4.2",
      "@types/react": "19.2.18",
      "aws4fetch": "1.0.20",
      "drizzle-orm": "0.45.3",
      "i18next": "26.4.2",
      "lucide-react": "1.48.0",
      "lucide-react-native": "1.48.0",
      "mediabunny": "1.61.1",
      "nativewind": "4.2.7",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "react-i18next": "17.0.15",
      "remotion": "4.0.532",
      "test-renderer": "1.2.0",
      "typescript": "7.0.2",
      "vite": "8.3.1",
      "vitest": "4.1.11",
      "wrangler": "4.147.0",
      "zod": "4.6.5"
    }
  },
  "scripts": {
    "admin:grant": "bun scripts/admin-grant.ts",
    "audit": "bun audit --production --ignore=GHSA-w5hq-g745-h8pq --ignore=GHSA-vcc3-ghjq-m6fr --ignore=GHSA-3wwx-pv8p-q78v --ignore=GHSA-67mh-4wv8-2f99 --ignore=GHSA-86w9-cpqp-85rv --ignore=GHSA-vfj7-8cjw-p6xm",
    "boundaries": "bun scripts/check-boundaries.ts",
    "build": "turbo build",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "check-types": "turbo run check-types check-types:scripts",
    "check-types:scripts": "tsc -p scripts",
    "cron": "bun scripts/cron.ts",
    "dev": "turbo dev",
    "knip": "knip --no-progress",
    "maintenance": "bun scripts/maintenance.ts",
    "mobile:release-check": "bun scripts/mobile-release-check.ts",
    "release:check": "bun run release:check:core && bun run release:check:tests && bun run release:check:mobile && bun run release:check:render",
    "release:check:core": "bun run check:ci && bun run boundaries && bun scripts/release-config-check.ts && bun run check-types && bun run build && bun -F @smog/site deploy:dry && bun run knip && bun run audit",
    "release:check:mobile": "bun run mobile:release-check",
    "release:check:render": "bun scripts/release-check-render.ts",
    "release:check:tests": "bun run test",
    "retention": "bun scripts/retention.ts",
    "test": "turbo run test test:scripts",
    "test:scripts": "bun test ./scripts"
  },
  "overrides": {
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@smog/config": "workspace:*",
    "@smog/jobs": "workspace:*",
    "@types/bun": "catalog:",
    "knip": "6.38.0",
    "turbo": "2.11.5",
    "typescript": "catalog:",
    "ultracite": "7.12.2"
  },
  "packageManager": "bun@1.3.11",
  "patchedDependencies": {
    "@openpanel/react-native@1.4.1": "patches/@openpanel%2Freact-native@1.4.1.patch"
  }
}
