{
  "name": "smog",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "upload"
    ],
    "catalog": {
      "hono": "^4.12.27",
      "@orpc/server": "^1.14.6",
      "@orpc/openapi": "^1.14.6",
      "@orpc/zod": "^1.14.6",
      "dotenv": "^17.2.3",
      "zod": "4.3.6",
      "@orpc/client": "^1.14.6"
    }
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@xmldom/xmldom": "0.8.13",
    "brace-expansion": "5.0.6",
    "expo-application": "55.0.16",
    "expo-constants": "55.0.16",
    "fast-uri": "4.1.0",
    "form-data": "4.0.6",
    "js-yaml": "3.15.0",
    "lodash": "4.18.1",
    "minimatch": "3.1.4",
    "node-forge": "1.4.0",
    "picomatch": "4.0.4",
    "postcss": "8.5.16",
    "rollup": "4.62.2",
    "serialize-javascript": "7.0.7",
    "shell-quote": "1.9.0",
    "svgo": "3.3.3",
    "uuid": "11.1.1",
    "ws": "8.21.0",
    "yaml": "2.9.0"
  },
  "scripts": {
    "check": "biome check --write .",
    "check:ci": "biome check apps packages scripts upload package.json turbo.json biome.json knip.json",
    "dev": "docker run -d --name smog-redis -p 6379:6379 --rm redis:7-alpine 2>/dev/null; turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "release:check": "bun run check:ci && bun run release:config-check && bun run check-types && bun run test && bun audit --production && bun run native:release-check && bun run build && knip --no-progress --no-config-hints",
    "release:config-check": "bun scripts/release-config-check.ts",
    "native:release-check": "bun scripts/native-release-check.ts",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "native:ios": "turbo -F native ios --",
    "native:ios:release": "turbo -F native ios -- --configuration Release --device",
    "native:ios:debug": "turbo -F native ios -- --configuration Debug",
    "native:android": "turbo -F native android --",
    "native:android:release": "turbo -F native android -- --variant release",
    "convex:codegen": "turbo -F @smog/convex codegen",
    "convex:dev": "turbo -F @smog/convex dev",
    "convex:deploy": "turbo -F @smog/convex deploy",
    "upload": "bun --cwd upload run upload",
    "delete-mux": "bun --cwd upload run delete-mux"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@types/bun": "^1.3.14",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "expo-doctor": "1.20.0",
    "knip": "^5.88.1",
    "turbo": "^2.10.2",
    "ultracite": "7.1.1"
  },
  "patchedDependencies": {
    "@openpanel/react-native@1.4.1": "patches/@openpanel%2Freact-native@1.4.1.patch"
  }
}
