# ==============================================
# SMOG - Docker Compose Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values

# ==============================================
# API Server Configuration
# ==============================================

# WorkOS Authentication
WORKOS_CLIENT_ID=your_workos_client_id
WORKOS_CLIENT_SECRET=your_workos_client_secret

# Mollie Payment Gateway
MOLLIE_API_KEY=your_mollie_api_key

# CORS Configuration
CORS_ORIGIN=http://localhost

# ==============================================
# Convex Backend
# ==============================================

# Convex Cloud URL (or self-hosted URL)
CONVEX_URL=https://your-project.convex.cloud

# ==============================================
# Mux Video Platform
# ==============================================

MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret

# ==============================================
# Web Application (Build-time variables)
# ==============================================

# API Server URL (exposed to frontend)
VITE_SERVER_URL=http://localhost:3000

# WorkOS Client ID (public)
VITE_WORKOS_CLIENT_ID=your_workos_client_id

# OAuth Redirect URI
VITE_WORKOS_REDIRECT_URI=http://localhost/auth/callback

# Convex URL (exposed to frontend)
VITE_CONVEX_URL=https://your-project.convex.cloud

# ==============================================
# Video Worker Configuration
# ==============================================

# Number of concurrent video processing jobs
VIDEO_COMPOSITION_CONCURRENCY=2

# Video Worker Service URL (for API server to connect)
VIDEO_WORKER_URL=http://video-worker:3002

# API Key for secure communication between services
# SECURITY: Change this in production! Generate with: openssl rand -base64 32
VIDEO_WORKER_API_KEY=dev-secret-key

# Server URL for video-worker to call back (internal Docker network)
SERVER_URL=http://server:3000

# ==============================================
# Monitoring Configuration
# ==============================================

# Grafana Admin Credentials
# SECURITY WARNING: Change this immediately in production!
# Generate a strong password: openssl rand -base64 32
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_IMMEDIATELY

# ==============================================
# SECURITY NOTES FOR MONITORING ACCESS
# ==============================================
# Monitoring tools (Grafana, Prometheus) are NOT exposed publicly.
# They are only accessible via SSH tunnel for security.
#
# To access Grafana:
#   1. SSH tunnel: ssh -L 3001:grafana:3000 user@your-server
#   2. Visit: http://localhost:3001
#   3. Login with credentials above
#
# To access Prometheus:
#   1. SSH tunnel: ssh -L 9090:prometheus:9090 user@your-server
#   2. Visit: http://localhost:9090
#
# See SECURITY.md for detailed instructions

# ==============================================
# Redis Configuration (Managed by Docker)
# ==============================================
# These are automatically set by docker-compose
# REDIS_SESSION_HOST=redis-session
# REDIS_QUEUE_HOST=redis-queue

# ==============================================
# Production VPS Configuration
# ==============================================
# Uncomment and configure for production deployment

# Your domain name
# DOMAIN=yourdomain.com

# Email for SSL certificates
# SSL_EMAIL=admin@yourdomain.com

# Production API URL
# VITE_SERVER_URL=https://api.yourdomain.com

# Production Web URL
# CORS_ORIGIN=https://yourdomain.com

# Production OAuth Redirect
# VITE_WORKOS_REDIRECT_URI=https://yourdomain.com/auth/callback
