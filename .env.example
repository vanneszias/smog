# ==============================================
# SMOG - Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values
#
# Development (local, no Docker needed except Redis):
#   bun dev
#
# Production (uses pre-built registry images):
#   docker compose up -d

# Registry image settings (production only)
REGISTRY_IMAGE_PREFIX=vanneszias
IMAGE_TAG=latest

# ==============================================
# API Server Configuration
# ==============================================

# WorkOS Authentication
WORKOS_CLIENT_ID=your_workos_client_id
WORKOS_CLIENT_SECRET=your_workos_client_secret

# Mollie Payment Gateway
MOLLIE_API_KEY=your_mollie_api_key

# CORS Configuration
CORS_ORIGIN=http://localhost

# ==============================================
# Convex Backend
# ==============================================

# Convex Cloud URL (or self-hosted URL)
CONVEX_URL=https://your-project.convex.cloud

# ==============================================
# Mux Video Platform
# ==============================================

MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret

# ==============================================
# Web Application (Build-time variables)
# ==============================================

# API Server URL (exposed to frontend)
VITE_SERVER_URL=http://localhost:3000

# WorkOS Client ID (public)
VITE_WORKOS_CLIENT_ID=your_workos_client_id

# OAuth Redirect URI
VITE_WORKOS_REDIRECT_URI=http://localhost/callback

# Convex URL (exposed to frontend)
VITE_CONVEX_URL=https://your-project.convex.cloud

# ==============================================
# OpenPanel Analytics (future integration)
# ==============================================

# Self-hosted OpenPanel API
VITE_OPENPANEL_API_URL=https://analytics.zias.be
EXPO_PUBLIC_OPENPANEL_API_URL=https://analytics.zias.be

# Create separate OpenPanel clients for web and native.
VITE_OPENPANEL_CLIENT_ID=your_web_openpanel_client_id
EXPO_PUBLIC_OPENPANEL_CLIENT_ID=your_native_openpanel_client_id
EXPO_PUBLIC_OPENPANEL_CLIENT_SECRET=your_native_openpanel_client_secret

# ==============================================
# Remotion Video Composition Configuration
# ==============================================

# Remotion Service URL (for API server to connect)
# Local dev: http://localhost:3002 | Production Docker: http://remotion:3002
REMOTION_URL=http://localhost:3002

# API key for secure communication between services.
# Generate with: openssl rand -base64 32
REMOTION_API_KEY=replace_with_a_random_secret

# Internal API key for server-to-server calls (e.g. Convex → email trigger)
# Generate with: openssl rand -base64 32
INTERNAL_API_KEY=replace_with_a_different_random_secret

# Server URL for Remotion to call back
# Local dev: http://localhost:3000 | Production Docker: http://server:3000
SERVER_URL=http://localhost:3000

# ==============================================
# Email (SMTP) Configuration
# ==============================================

# SMTP server hostname
SMTP_HOST=smtp.example.com

# SMTP port (587 for STARTTLS, 465 for SSL, 25 for plain)
SMTP_PORT=587

# SMTP authentication
SMTP_USER=user@example.com
SMTP_PASS=yourpassword

# Sender address shown to recipients
SMTP_FROM="Smog <no-reply@example.com>"

# IMAP server hostname (for saving sent mail to mailbox)
IMAP_HOST=imap.example.com

# IMAP port (993 for SSL, 143 for STARTTLS)
IMAP_PORT=993

# IMAP authentication (usually same credentials as SMTP)
IMAP_USER=user@example.com
IMAP_PASS=yourpassword

# Set to "false" to disable TLS certificate verification (dev/self-signed certs only)
# IMAP_TLS_REJECT_UNAUTHORIZED=false

# ==============================================
# Redis Configuration
# ==============================================
# Redis URL for BullMQ email queue (DB index 1 to avoid collision with sessions)
# Local dev: redis://localhost:6379/1 (started automatically by bun dev)
# Production Docker: redis://redis-session:6379/1
REDIS_URL=redis://localhost:6379/1

# ==============================================
# OpenTelemetry (optional)
# ==============================================
# Leave unset to disable — only console logging will be active.

# Service name shown in your observability backend (default: smog-server)
# OTEL_SERVICE_NAME=smog-server

# Base OTLP HTTP endpoint (enables log export when set)
# Grafana Cloud: https://otlp-gateway-prod-eu-west-0.grafana.net/otlp
# Self-hosted Alloy: http://alloy:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-0.grafana.net/otlp

# Auth headers for the OTLP exporter (comma-separated key=value pairs)
# Grafana Cloud: Authorization=Basic <base64(instanceId:apiKey)>
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64>
