# ==============================================
# SMOG - Environment Configuration
# ==============================================
# The variables the apps read, in one place. Each app loads `.env` from its
# own directory, not from the repo root: copy what an app needs into
# `apps/site/.env` or `apps/mobile/.env`.
#
# Deployed environments have no `.env`: apps/site's values are `vars` entries
# in apps/site/wrangler.jsonc or `wrangler secret put ... --env=<env>` secrets,
# and apps/mobile's are EAS environment variables
# (docs/deployment-checklist.md).

# ==============================================
# Payload / Cloudflare (apps/site)
# ==============================================

PAYLOAD_SECRET=            # openssl rand -hex 32

# staging | production — has NO default. `deploy:database` and `deploy:app`
# both refuse to run (non-zero exit, no migration/build) when this is unset.
CLOUDFLARE_ENV=staging

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=      # CI only: Workers Scripts edit, D1 edit, R2 edit

# ==============================================
# Mollie Payment Gateway (apps/site)
# ==============================================

MOLLIE_API_KEY=your_mollie_api_key

# ==============================================
# Mux Video Platform (apps/site)
# ==============================================

MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret

# ==============================================
# OpenPanel Analytics
# ==============================================
#
# apps/site relays web events to OpenPanel through POST /api/analytics/track,
# so its client secret stays server-side. In a deployed apps/site,
# OPENPANEL_API_URL is a `vars` entry per environment in
# apps/site/wrangler.jsonc, and the id and secret are set with
# `wrangler secret put ... --env=<staging|production>`. They are never
# committed, and never a `vars` entry — a client secret a browser could reach
# is the exact thing the relay exists to prevent.
#
# With the id or the secret missing, the relay accepts events and drops them,
# which is the right state for a local checkout and for CI.

# Self-hosted OpenPanel API.
OPENPANEL_API_URL=https://analytics.zias.be/api
EXPO_PUBLIC_OPENPANEL_API_URL=https://analytics.zias.be/api

# Web analytics (apps/site); never exposed to a browser.
OPENPANEL_CLIENT_ID=your_web_openpanel_client_id
OPENPANEL_CLIENT_SECRET=your_web_openpanel_client_secret

# apps/mobile sends from the device and uses a separate least-privileged
# OpenPanel client: every EXPO_PUBLIC_* value ships inside the app bundle.
EXPO_PUBLIC_OPENPANEL_CLIENT_ID=your_mobile_openpanel_client_id
EXPO_PUBLIC_OPENPANEL_CLIENT_SECRET=your_mobile_openpanel_client_secret

# ==============================================
# Mobile API (apps/mobile)
# ==============================================

# The apps/site origin, with no /api suffix. Unset, the app talks to the
# staging Worker (apps/mobile/src/lib/api.ts).
# EXPO_PUBLIC_API_URL=http://localhost:3003
