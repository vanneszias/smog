# Root environment for local tooling. Copy to `.env` and fill in when needed.
# The site Worker reads its vars from `apps/site/wrangler.jsonc` and secrets
# from `apps/site/.dev.vars`; the mobile app reads `EXPO_PUBLIC_*` from
# `apps/mobile/.env`. Nothing here is required to run `bun dev` locally.

# Skip Playwright browser downloads (Chromium is provided at /opt/pw-browsers).
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Turborepo remote cache (optional).
# TURBO_TOKEN=
# TURBO_TEAM=
