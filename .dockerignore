# ── Dependencies (never copy node_modules into build context) ─────────────────
node_modules
**/node_modules

# ── Build outputs (rebuilt inside Docker) ─────────────────────────────────────
dist
build
out
.turbo
.next

# ── Environment & secrets (injected at runtime, not baked into images) ────────
.env
.env.*
!.env.example

# ── Native app (not deployed via Docker) ─────────────────────────────────────
apps/native/**
!apps/native/package.json

# ── Development tooling ───────────────────────────────────────────────────────
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# ── Test artifacts ────────────────────────────────────────────────────────────
coverage
.nyc_output
**/__tests__
**/__mocks__

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs

# ── Documentation (not needed at runtime) ────────────────────────────────────
docs
*.md
!README.md

# ── CI/CD & repo metadata ─────────────────────────────────────────────────────
.git
.gitignore
.gitattributes
.github
.gitea
.gitlab-ci.yml

# ── Monitoring (managed separately) ──────────────────────────────────────────
monitoring
