    "@smog/i18n": "workspace:*",
    "@smog/jobs": "workspace:*",
    "@smog/lists": "workspace:*",
    "@smog/local-store": "workspace:*",
    "@smog/payments": "workspace:*",
    "@smog/render": "workspace:*",
    "@smog/rpc": "workspace:*",
    "@smog/sponsorships": "workspace:*",
    "@smog/styles": "workspace:*",
    "@smog/ui-web": "workspace:*",
    "@smog/utils": "workspace:*",
