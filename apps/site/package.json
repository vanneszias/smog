{
  "name": "@smog/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && bun scripts/deploy-guard.ts --bundle",
    "cf-typegen": "wrangler types",
    "check-types": "wrangler types && tsc -b && tsc -p scripts",
    "deploy": "turbo run build --filter=@smog/site^... && vite build && bun scripts/deploy-guard.ts && wrangler deploy --env $CLOUDFLARE_ENV",
    "deploy:dry": "CLOUDFLARE_ENV=staging bun run deploy --dry-run",
    "dev": "vite dev --port 5173",
    "preview": "vite preview",
    "test": "bun ../../packages/testing/runner.ts --package site",
    "test:e2e": "bun ../../packages/testing/runner.ts --runtime e2e"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
