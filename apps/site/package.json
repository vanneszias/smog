{
  "name": "@smog/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && bun scripts/deploy-guard.ts --bundle",
    "cf-typegen": "wrangler types",
    "check-types": "wrangler types && tsc -b && tsc -p scripts && tsc -p e2e",
    "deploy": "vite build && bun scripts/deploy-guard.ts && wrangler deploy --env $CLOUDFLARE_ENV",
    "deploy:dry": "CLOUDFLARE_ENV=staging bun run deploy --dry-run",
    "dev": "vite dev --port 5173",
    "preview": "vite preview",
    "test": "bun ../../scripts/test-deadline.ts -- vitest run && bun ../../scripts/test-deadline.ts -- bun test scripts && bun ../../scripts/test-deadline.ts -- bun test --timeout=20000 --preload @smog/config/testing/happy-dom src",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@cloudflare/containers": "catalog:",
    "@dnd-kit/core": "6.3.1",
