/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# The brand artwork keeps its URL when it changes (nothing here is
# content-addressed), so it gets a day rather than a year: long enough that a
# visitor paging through the site fetches the header logo once, short enough
# that a new logo reaches everyone by the next day.
/brand/*
  Cache-Control: public,max-age=86400

# The files the iOS and Android apps verify this domain with. Apple asks for
# application/json, and the platform infers a type from the extension, so the
# extensionless apple-app-site-association would otherwise go out with no
# Content-Type at all (checked with a local `wrangler dev`). Both are static
# assets, which the platform serves before the Worker runs: no Next route,
# rewrite or redirect is ever in front of them, and Apple refuses a redirect
# here outright.
/.well-known/apple-app-site-association
  Content-Type: application/json

/.well-known/assetlinks.json
  Content-Type: application/json
