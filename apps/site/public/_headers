# Workers static assets headers, checked by scripts/release-config-check.ts.
# The AASA file has no extension, so without this it is not served as JSON.
/.well-known/apple-app-site-association
  Content-Type: application/json
/.well-known/assetlinks.json
  Content-Type: application/json
# Static assets are served before the Worker runs, so they do not get the
# Worker's security headers (src/worker/headers.ts); they get these instead.
# test/security-headers.test.ts keeps them equal to the Worker's. HSTS is
# ignored by browsers over plain http (dev); no CSP or X-Frame-Options here:
# the static files are images and JSON, never documents.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
# Cache policy (src/worker/cache.ts holds the same table for the Worker's own
# responses; test/cache-policy.test.ts keeps the two equal). Vite's hashed
# output is immutable, by extension rather than a blanket /assets/*: the
# legacy /assets/logo.svg is not hashed and gets the one-day policy below.
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable
/assets/*.css
  Cache-Control: public, max-age=31536000, immutable
/assets/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/assets/logo.svg
  Cache-Control: public, max-age=86400
/brand/*
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=86400
/icon-512.png
  Cache-Control: public, max-age=86400
/icon-maskable-512.png
  Cache-Control: public, max-age=86400
/icon.svg
  Cache-Control: public, max-age=86400
/og.png
  Cache-Control: public, max-age=86400
