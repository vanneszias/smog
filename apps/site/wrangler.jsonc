// D1 and R2 bindings live only inside the named `staging` and `production`
// environments below, never at the top level, so neither can be reached by
// accident: a deploy with no --env resolves this bindingless top level and
// fails rather than silently touching the wrong database.
//
// Because of that, `wrangler types` emits D1 and R2 as optional on the base
// CloudflareEnv, which is why payload.config.ts asserts them via
// requireBinding() instead of a non-null assertion.
//
// Deploy order is always schema then code: `deploy:database`, then
// `deploy:app`. Both refuse to run unless CLOUDFLARE_ENV is exactly
// "staging" or "production".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "smog-site",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "env": {
    "staging": {
      "name": "smog-site-staging",
      "d1_databases": [
        {
          "binding": "D1",
          "database_name": "smog-staging",
          "database_id": "de652ee5-3851-4b02-85fb-f4eb8bddfe29",
          "remote": true,
        },
      ],
      "r2_buckets": [{ "binding": "R2", "bucket_name": "smog-staging-media" }],
    },
    "production": {
      "name": "smog-site-production",
      "d1_databases": [
        {
          "binding": "D1",
          "database_name": "smog-production",
          "database_id": "6f48c5c2-43f3-44a9-a083-46d18bf44831",
          "remote": true,
        },
      ],
      "r2_buckets": [
        { "binding": "R2", "bucket_name": "smog-production-media" },
      ],
    },
  },
}
