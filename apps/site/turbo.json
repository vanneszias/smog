{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["CLOUDFLARE_ENV", "SMOG_RENDER_PIPELINE"],
      "outputs": ["dist/**", ".wrangler/deploy/**"]
    },
    "dev": {
      "passThroughEnv": ["CLOUDFLARE_ENV", "SMOG_DEV_RENDER_MODE"]
    },
    "check-types": {
      "outputs": ["worker-configuration.d.ts"]
    }
  }
}
