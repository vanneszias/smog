{
  "extends": "@smog/config/tsconfig/worker.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "@cloudflare/vitest-plugin/types"]
  },
  "include": [
    "src",
    "test",
    "build-defines.ts",
    "render-config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
