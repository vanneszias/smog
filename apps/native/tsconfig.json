{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@components/*": ["components/*"],
      "@/components/*": ["components/*"],
      "@/context/*": ["context/*"],
      "@/screens/*": ["screens/*"],
      "@/services/*": ["services/*"],
      "@/styles/*": ["styles/*"],
      "@/translations/*": ["translations/*"],
      "@/assets/*": ["assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
