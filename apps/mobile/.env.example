# Local development: copy to apps/mobile/.env (gitignored). On a device, use
# your machine's LAN address instead of localhost.
#
# EAS builds take the three origin keys below from their profile's `env` in
# eas.json (development → dev, staging → staging's SITE_URL, production →
# PRODUCTION_LAUNCH_ORIGIN; scripts/release-config-check.ts keeps them equal).
EXPO_PUBLIC_ENVIRONMENT=dev
EXPO_PUBLIC_API_URL=http://localhost:5173
EXPO_PUBLIC_SITE_HOST=localhost

# Optional. A write-only OpenPanel client (analytics.zias.be); analytics is
# off without both. The API URL defaults to https://analytics.zias.be/api.
#
# EAS builds never read these from git: the owner sets them as EAS
# environment variables, one pair per EAS environment (development, preview,
# production; each profile's `environment` in eas.json), with visibility
# "Plain text" because the pair ships in the app binary:
#   eas env:create --environment production --visibility plaintext \
#     --name EXPO_PUBLIC_OPENPANEL_CLIENT_ID --value <id>
# (and the same for EXPO_PUBLIC_OPENPANEL_CLIENT_SECRET, and for preview and
# development). Never add them to eas.json.
EXPO_PUBLIC_OPENPANEL_CLIENT_ID=
EXPO_PUBLIC_OPENPANEL_CLIENT_SECRET=
# EXPO_PUBLIC_OPENPANEL_API_URL=https://analytics.zias.be/api
