{
  "name": "server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "@mux/mux-node": "^12.8.1",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@smog/api": "workspace:*",
    "@smog/auth": "workspace:*",
    "@smog/convex": "workspace:*",
    "bullmq": "^5.66.0",
    "convex": "^1.31.0",
    "dotenv": "catalog:",
    "fluent-ffmpeg": "^2.1.3",
    "hono": "catalog:",
    "ioredis": "^5.8.2",
    "node-cron": "^4.2.1",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@smog/config": "workspace:*",
    "@types/bun": "^1.2.6",
    "@types/node-cron": "^3.0.11",
    "tsdown": "^0.16.5",
    "typescript": "^5.8.2"
  }
}
