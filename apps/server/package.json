{
  "name": "server",
  "version": "1.0.1",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --env-file ../../.env --hot src/index.ts",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "@mux/mux-node": "^14.1.1",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@react-email/components": "^0.0.36",
    "@react-email/render": "^1.4.0",
    "@smog/api": "workspace:*",
    "@smog/auth": "workspace:*",
    "@smog/convex": "workspace:*",
    "@smog/shared": "workspace:*",
    "@smog/types": "workspace:*",
    "bullmq": "^5.79.2",
    "convex": "^1.42.1",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "ioredis": "^5.11.1",
    "node-cron": "^4.5.0",
    "imapflow": "^1.4.3",
    "nodemailer": "9.0.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@smog/config": "workspace:*",
    "@types/bun": "^1.3.13",
    "@types/nodemailer": "^6.4.23",
    "typescript": "^5.9.3"
  }
}
