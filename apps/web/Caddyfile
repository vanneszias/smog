https://app.smog.vlaanderen {
    root * /srv
    encode gzip zstd

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://eu-assets.i.posthog.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' blob: https://*.mux.com https://stream.mux.com; font-src 'self' data:; connect-src 'self' https://*.convex.cloud https://api.workos.com https://authkit.workos.com wss://*.convex.cloud https://*.posthog.com https://eu.i.posthog.com https://eu-assets.i.posthog.com https://*.mux.com https://inferred.litix.io; frame-ancestors 'self';"
    }
    handle_path /api* {
        reverse_proxy server:3000
    }
    handle /rpc/* {
        reverse_proxy server:3000
    }
    handle /auth/* {
        reverse_proxy server:3000
    }
    handle /webhooks/* {
        reverse_proxy server:3000
    }
    handle /health {
        respond "OK" 200
    }
    handle {
        try_files {path} /index.html
        file_server
    }
}
