https://app.smog.vlaanderen {
    root * /srv
    encode gzip zstd

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        Cross-Origin-Opener-Policy "same-origin"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' blob: https://*.mux.com https://stream.mux.com; font-src 'self' data:; connect-src 'self' https://*.convex.cloud https://api.workos.com https://authkit.workos.com wss://*.convex.cloud https://*.mux.com https://inferred.litix.io; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests;"
    }
    @immutable path /assets/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"
    @appAssociation path /.well-known/apple-app-site-association /.well-known/assetlinks.json
    header @appAssociation Content-Type "application/json"
    handle /api/* {
        reverse_proxy server:3000
    }
    handle /rpc/* {
        reverse_proxy server:3000
    }
    handle /analytics/* {
        reverse_proxy server:3000
    }
    handle /auth/* {
        reverse_proxy server:3000
    }
    handle /webhooks/* {
        reverse_proxy server:3000
    }
    handle /health {
        respond "OK" 200
    }
    handle {
        try_files {path} /index.html
        file_server
    }
}
