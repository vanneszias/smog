{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "${configDir}/node_modules/.cache/tsc",
    "tsBuildInfoFile": "${configDir}/node_modules/.cache/tsc/tsconfig.tsbuildinfo"
  }
}
