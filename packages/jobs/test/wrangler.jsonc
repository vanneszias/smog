{
  // Test-only Worker config: Miniflare queue producers for the producer
  // tests (no consumer: messages stay on the queue), a local KV (`KV`: the
  // email consumer's idempotency markers and the dev mailbox), and the
  // source of `worker-configuration.d.ts` (`wrangler types`, check-types).
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "smog-jobs-test",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    { "binding": "KV", "id": "00000000000000000000000000000000" }
  ],
  "queues": {
    "producers": [
      { "binding": "EMAIL_QUEUE", "queue": "smog-test-email" },
      { "binding": "EVENTS_QUEUE", "queue": "smog-test-sponsorship-events" }
    ]
  }
}
