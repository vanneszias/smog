{
  "name": "@smog/pdf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./assets/*": "./assets/*",
    "./png": "./src/png-guard.ts"
  },
  "scripts": {
    "check-types": "wrangler types --config test/wrangler.jsonc && tsc -b && tsc -p tsconfig.test.json",
    "test": "bun ../../scripts/test-deadline.ts -- vitest run && bun ../../scripts/test-deadline.ts -- bun test src"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@smog/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "unpdf": "1.9.1",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
