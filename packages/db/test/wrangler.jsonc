{
  // Test-only Worker config: gives the Vitest pool a local D1 as `DB`.
  // Migrations are applied by `src/testing/apply-migrations.ts` (setupFiles).
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "smog-db-test",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smog-test",
      "database_id": "00000000-0000-4000-8000-000000000000"
    }
  ]
}
