{
  // The Worker side (./server), with the Workers types. The D1 tests are
  // checked by tsconfig.test.json (they reach the lists and favorites
  // builders by relative path, which a composite project cannot hold), and
  // the bun tests and the client-safe entries by tsconfig.client.json (no
  // Workers types).
  "extends": "@smog/config/tsconfig/worker.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  "include": ["src", "vitest.config.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/testing"]
}
