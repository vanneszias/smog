{
  "$schema": "./node_modules/knip/schema.json",
  "ignore": ["packages/testing/support/tooling/__fixtures__/**"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"],
      "ignoreDependencies": []
    },
    "packages/*": {
      "entry": [],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/styles": {
      "entry": [],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "generated/*.{css,cjs}"]
    },
    "packages/utils": {
      "entry": ["src/**/*.native.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ui-web": {
      "entry": [],
      "project": ["src/**/*.{ts,tsx,css}"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "packages/db": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"],
      "ignoreDependencies": []
    },
    "packages/email": {
      "entry": [],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": []
    },
    "packages/jobs": {
      "entry": [],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@types/react"]
    },
    "packages/auth": {
      "entry": [],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": []
    },
    "packages/analytics": {
      "entry": [],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/rpc": {
      "entry": [],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/features/*": {
      "entry": [],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": []
    },
    "packages/features/admin": {
      "entry": [],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": []
    },
    "packages/features/lessons": {
      "entry": [],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": []
    },
    "packages/pdf": {
      "entry": [],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": []
    },
    "packages/migrate-convex": {
      "entry": [],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": []
    },
    "packages/api": {
      "entry": [],
      "project": ["src/**/*.ts"]
    },
    "packages/ui-native": {
      "babel": {
        "config": ["babel.config.cjs"]
      },
      "entry": [],
      "project": ["src/**/*.{ts,tsx}", "*.{ts,cts,cjs}"]
    },
    "apps/site": {
      "entry": ["src/routes/**/*.{ts,tsx}", "scripts/*.ts"],
      "project": ["src/**/*.{ts,tsx,css}", "scripts/**/*.ts"],
      "ignoreDependencies": ["cloudflare"]
    },
    "apps/mobile": {
      "ignoreDependencies": ["expo-crypto", "expo-network"],
      "entry": ["app/**/*.{ts,tsx}", "plugins/*.js", "src/dev/*.tsx"],
      "project": [
        "app/**/*.{ts,tsx}",
        "src/**/*.{ts,tsx}",
        "plugins/**/*.js",
        "*.{js,ts,css}"
      ]
    },
    "packages/testing": {
      "entry": [
        "deadline.ts",
        "{bun,workers,native,e2e}/**/*.{test,spec}.{ts,tsx}",
        "config/**/*.{ts,cjs}",
        "samples/*.ts",
        "support/config/happy-dom.ts",
        "bun/auth/guard/client-types.ts"
      ],
      "project": ["**/*.{ts,tsx,cjs,css}"],
      "ignoreDependencies": ["cloudflare", "@smog/migrate-convex"],
      "jest": {
        "config": ["config/native/*/jest.config.cjs"]
      },
      "playwright": {
        "config": ["config/playwright.ts"]
      }
    }
  }
}
