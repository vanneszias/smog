{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreFiles": [".agents/**"],
  "ignoreDependencies": ["expo-doctor"],
  "ignoreIssues": {
    "apps/render/src/utils/get-media-metadata.ts": ["types"]
  },
  "workspaces": {
    "apps/site": {
      "entry": [
        "src/app/**/*.{ts,tsx}",
        "src/payload.config.ts",
        "src/seed/index.ts",
        "scripts/*.ts",
        "scripts/migrate-convex/index.ts",
        "next.config.ts",
        "open-next.config.ts",
        "playwright.config.ts",
        "vitest.config.mts",
        "vitest.setup.ts"
      ],
      "ignore": ["src/payload-types.ts", "src/migrations/**"],
      "payload": false
    },
    "apps/mobile": {
      "entry": ["app/**/*.{ts,tsx}", "metro.config.js", "tailwind.config.js"],
      "ignoreDependencies": ["@babel/core", "tailwindcss"]
    },
    "apps/render": {
      "entry": ["remotion.config.ts", "src/index.ts"],
      "ignoreDependencies": ["@remotion/lambda"]
    },
    "packages/shared": {
      "entry": ["src/index.ts", "src/otel.ts"],
      "ignoreDependencies": [
        "@opentelemetry/exporter-logs-otlp-http",
        "@opentelemetry/resources",
        "@opentelemetry/sdk-logs"
      ]
    },
    "packages/ui-native": {
      "entry": [
        "src/index.ts",
        "tailwind.config.js",
        "babel.config.js",
        "scripts/*.ts"
      ],
      "ignoreDependencies": ["@babel/core", "tailwindcss"]
    }
  }
}
