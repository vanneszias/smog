{
  "$schema": "./node_modules/knip/schema.json",
  "ignore": ["scripts/__fixtures__/**"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "packages/*": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/site": {
      "entry": ["src/routes/**/*.{ts,tsx}", "test/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx,css}", "test/**/*.ts"],
      "ignoreDependencies": ["cloudflare"]
    }
  }
}
