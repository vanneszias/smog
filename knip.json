{
  "$schema": "./node_modules/knip/schema.json",
  "ignore": ["scripts/__fixtures__/**"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/styles": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "generated/*.{css,cjs}"]
    },
    "packages/render": {
      "entry": [
        "src/server/{main,bundle,fixture,ensure-browser}.ts",
        "src/server/fixture-card.tsx",
        "src/**/*.test.{ts,tsx}",
        "test/**/*.test.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.ts"]
    },
    "packages/ui-web": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx,css}"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "packages/db": {
      "entry": ["test/**/*.test.ts", "scripts/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"],
      "ignoreDependencies": ["cloudflare"]
    },
    "packages/email": {
      "entry": ["test/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"],
      "ignoreDependencies": ["cloudflare"]
    },
    "packages/jobs": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["cloudflare", "@types/react"]
    },
    "packages/auth": {
      "entry": [
        "test/**/*.test.{ts,tsx}",
        "src/**/*.test.{ts,tsx}",
        "guard/*.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}", "guard/**/*.ts"],
      "ignoreDependencies": ["cloudflare"]
    },
    "packages/analytics": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/rpc": {
      "entry": ["test/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"]
    },
    "packages/features/*": {
      "entry": ["test/**/*.test.{ts,tsx}", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"],
      "ignoreDependencies": ["cloudflare"]
    },
    "packages/features/admin": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.ts"],
      "ignoreDependencies": ["cloudflare"]
    },
    "packages/migrate-convex": {
      "entry": ["src/cli/main.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": [
        "cloudflare",
        "@smog/account",
        "@smog/admin",
        "@smog/auth",
        "@smog/email",
        "@smog/favorites",
        "@smog/gestures",
        "@smog/jobs",
        "@smog/lists",
        "@smog/payments",
        "@smog/render",
        "@smog/rpc",
        "@smog/video"
      ]
    },
    "packages/api": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/ui-native": {
      "babel": {
        "config": ["babel.config.cjs"]
      },
      "entry": ["src/**/*.test.{ts,tsx}", "jest.setup*.ts"],
      "project": ["src/**/*.{ts,tsx}", "*.{ts,cts,cjs}"]
    },
    "apps/site": {
      "entry": [
        "src/routes/**/*.{ts,tsx}",
        "test/**/*.test.ts",
        "src/**/*.test.{ts,tsx}",
        "scripts/*.ts",
        "e2e/**/*.spec.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx,css}",
        "test/**/*.ts",
        "scripts/**/*.ts",
        "e2e/**/*.ts"
      ],
      "ignoreDependencies": ["cloudflare"]
    },
    "apps/mobile": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "plugins/*.js",
        "src/**/*.test.{ts,tsx}",
        "src/dev/*.tsx"
      ],
      "project": [
        "app/**/*.{ts,tsx}",
        "src/**/*.{ts,tsx}",
        "plugins/**/*.js",
        "*.{js,ts,css}"
      ]
    }
  }
}
