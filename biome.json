{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "!**/.next",
      "!**/dist",
      "!**/.turbo",
      "!**/dev-dist",
      "!**/.zed",
      "!**/.vscode",
      "!**/routeTree.gen.ts",
      "!**/src-tauri",
      "!**/.nuxt",
      "!bts.jsonc",
      "!**/.expo",
      "!**/.wrangler",
      "!**/.alchemy",
      "!**/.svelte-kit",
      "!**/wrangler.jsonc",
      "!**/.source",
      "!**/_generated",
      "!**/.agents",
      "!**/*.svg"
    ]
  },
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/jest"
  ],
  "javascript": {
    "globals": ["__DEV__", "Bun"]
  },
  "linter": {
    "rules": {
      "performance": {
        "noBarrelFile": "off",
        "noNamespaceImport": "off",
        "useTopLevelRegex": "off"
      },
      "complexity": {
        "noForEach": "off",
        "useMaxParams": "off"
      },
      "style": {
        "useFilenamingConvention": "off",
        "noNestedTernary": "off",
        "useDefaultSwitchClause": "off",
        "noNonNullAssertion": "off",
        "noExportedImports": "off",
        "useConsistentMemberAccessibility": "off",
        "noIncrementDecrement": "off"
      },
      "suspicious": {
        "noAlert": "off",
        "useAwait": "off",
        "noShadow": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/native/metro.config.js"],
      "linter": {
        "rules": {
          "correctness": {
            "noGlobalDirnameFilename": "off"
          }
        }
      }
    }
  ]
}
