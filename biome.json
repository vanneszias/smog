{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "!!**/dist",
      "!!**/.wrangler",
      "!!**/.expo",
      "!!**/.output",
      "!!**/.tanstack",
      "!!**/routeTree.gen.ts",
      "!!**/worker-configuration.d.ts",
      "!!**/*.gen.*",
      "!!packages/db/migrations/meta",
      "!!apps/mobile/assets",
      "!!apps/site/public",
      "!!packages/styles/generated",
      "!!packages/brand/src/art",
      "!!.agents",
      "!!docs/superpowers/analysis"
    ]
  },
  "javascript": {
    "globals": [
      "__DEV__",
      "__SMOG_DEV_TOOLS__",
      "__SMOG_E2E_SEED__",
      "__SMOG_THEME_SCRIPT_HASH__"
    ]
  },
  "overrides": [
    {
      "includes": [
        "scripts/**",
        "packages/render/src/server/**/*.ts",
        "packages/render/test/**/*.ts",
        "packages/migrate-convex/src/cli/**/*.ts",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "javascript": {
        "globals": ["Bun"]
      }
    },
    {
      "includes": ["packages/**/src/**", "apps/site/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "drizzle-orm": {
                    "importNames": ["inArray", "notInArray"],
                    "message": "D1 binds at most 100 parameters per statement: use inList or jsonList from @smog/db (one json_each parameter), or a subquery in sql``."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/global.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": {
              "level": "error",
              "options": {
                "ignore": ["tailwind"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/*.js", "apps/mobile/plugins/**/*.js"],
      "linter": {
        "rules": {
          "correctness": {
            "noGlobalDirnameFilename": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/site/src/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/db/src/schema/**"],
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off"
          }
        }
      }
    }
  ]
}
